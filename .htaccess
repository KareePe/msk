# ===== Performance: บีบอัดไฟล์ข้อความ =====
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>

# ===== Performance: cache ฝั่งเบราว์เซอร์ =====
# CSS/JS ใส่ ?v=... ใน index.html แล้ว เมื่อแก้ไฟล์ให้เปลี่ยนเลข v เพื่อให้ผู้ใช้ได้ไฟล์ใหม่
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType text/plain .txt
  AddCharset utf-8 .txt .xml .html .css .js
</IfModule>

# ===== Security headers ที่มีผลต่อคะแนน Lighthouse =====
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ไม่ให้เข้าถึงไฟล์ design ต้นฉบับจากเว็บ
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^design/ - [F,L]
</IfModule>
